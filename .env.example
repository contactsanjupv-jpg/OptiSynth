# ============================================================
# Backend environment variables. Copy this file to `.env` in the
# project root and fill in real values. NEVER commit `.env` itself --
# it's excluded in .gitignore.
# ============================================================

# --- Secrets (required -- the app refuses to start without these) ---

# Signs session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Peppers password hashes (mixed in alongside each user's random salt).
# Generate the same way as SECRET_KEY, but use a DIFFERENT value.
PASSWORD_PEPPER=

# Only required if you enable the legacy API-key integration path
# (backend/app/security/api_keys.py) -- not used by the web frontend.
API_KEY_PEPPER=

# --- Database ---

# Local dev (default if unset): SQLite, file created automatically.
# DATABASE_URL=sqlite:///./data/rdopt.db

# Production: point at PostgreSQL. Requires psycopg2-binary (already in
# backend/requirements.txt).
# DATABASE_URL=postgresql+psycopg2://rdopt_user:password@localhost:5432/rdopt

# --- Session cookie ---
SESSION_COOKIE_NAME=rdopt_session
SESSION_LIFETIME_HOURS=12
# Set to "true" only when serving over real HTTPS -- browsers silently
# drop Secure cookies over plain HTTP, which would break local dev.
SESSION_COOKIE_SECURE=false

# --- CORS: must match the frontend's real origin exactly ---
CORS_ALLOWED_ORIGIN=http://localhost:3000

# --- Uploads ---
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_ROWS=20000

# --- Server ---
PORT=5050
# "development" or "production" -- controls error detail verbosity and
# whether /docs and /redoc are exposed. See backend/app/main.py.
ENV=development
